# Copie este arquivo para ".env" e preencha. NUNCA faça commit do ".env".

# Chave do Google AI Studio (https://aistudio.google.com/apikey). Deixe vazio para rodar só em mock.
GEMINI_API_KEY=

# Modelo da família Flash. "gemini-flash-lite-latest" respondeu em ~1 s nos testes de 14/11;
# "gemini-flash-latest" estava devolvendo 503 (sobrecarga). Confira os nomes disponíveis no AI Studio.
GEMINI_MODEL=gemini-flash-lite-latest

# MOCK=1 -> sem chave e sem rede: usa as respostas salvas em fixtures/.
MOCK=0

# Porta do servidor local.
PORT=3000
